+/*
+ * Try to mount root filesystem from a priority list
+ * Format: "device1;device2;device3"
+ * Returns 0 on success, -1 on failure
+ */
+static int __init mount_root_priority_list(void)
+{
+	char *root_list, *current_root, *next_root;
+	char *root_list_copy;
+	int ret = -1;
+	int root_count = 0;
+
+	if (!root_pr_list)
+		return -1;
+
+	/* Create a copy of the root_pr_list for parsing */
+	root_list_copy = kstrdup(root_pr_list, GFP_KERNEL);
+	if (!root_list_copy)
+		return -1;
+
+	root_list = root_list_copy;
+	printk(KERN_INFO "VFS: Trying root filesystems from priority list: %s\n", root_pr_list);
+
+	/* Parse the list separated by semicolons */
+	while (root_list && *root_list) {
+		/* Find the next semicolon */
+		next_root = strchr(root_list, ';');
+		if (next_root) {
+			*next_root = '\0';
+			next_root++;
+		}
+
+		/* Trim whitespace from current root */
+		current_root = root_list;
+		while (*current_root == ' ' || *current_root == '\t')
+			current_root++;
+
+		/* Skip empty entries */
+		if (*current_root == '\0') {
+			root_list = next_root;
+			continue;
+		}
+
+		root_count++;
+		printk(KERN_INFO "VFS: Attempting to mount root filesystem #%d: %s\n", 
+		       root_count, current_root);
+
+		/* Try to mount this root filesystem */
+		ret = try_mount_single_root(current_root);
+		if (ret == 0) {
+			printk(KERN_INFO "VFS: Successfully mounted root filesystem #%d: %s\n", 
+			       root_count, current_root);
+			break;
+		}
+
+		printk(KERN_WARNING "VFS: Failed to mount root filesystem: %s\n", current_root);
+
+		/* Move to next root filesystem */
+		root_list = next_root;
+	}
+
+	kfree(root_list_copy);
+
+	if (ret != 0) {
+		printk(KERN_ERR "VFS: Failed to mount any root filesystem from priority list\n");
+	}
+
+	return ret;
+}
