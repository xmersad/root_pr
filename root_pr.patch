+/*
+ * Try to mount a single root filesystem safely without panicking
+ * Returns 0 on success, -1 on failure
+ */
+static int __init try_mount_single_root(const char *root_name)
+{
+	struct page *page = alloc_page(GFP_KERNEL);
+	char *fs_names = page_address(page);
+	char *p;
+	char b[BDEVNAME_SIZE];
+	int num_fs, i;
+	int ret = -1;
+
+	if (!page)
+		return -1;
+
+	/* Handle special cases for network filesystems */
+	if (strcmp(root_name, "/dev/nfs") == 0) {
+#ifdef CONFIG_ROOT_NFS
+		put_page(page);
+		if (mount_nfs_root()) {
+			printk(KERN_INFO "VFS: Successfully mounted NFS root\n");
+			return 0;
+		}
+		printk(KERN_WARNING "VFS: Failed to mount NFS root\n");
+		return -1;
+#else
+		put_page(page);
+		printk(KERN_WARNING "VFS: NFS root not supported (CONFIG_ROOT_NFS not enabled)\n");
+		return -1;
+#endif
+	}
+
+	if (strcmp(root_name, "/dev/cifs") == 0) {
+#ifdef CONFIG_CIFS_ROOT
+		put_page(page);
+		if (mount_cifs_root()) {
+			printk(KERN_INFO "VFS: Successfully mounted CIFS root\n");
+			return 0;
+		}
+		printk(KERN_WARNING "VFS: Failed to mount CIFS root\n");
+		return -1;
+#else
+		put_page(page);
+		printk(KERN_WARNING "VFS: CIFS root not supported (CONFIG_CIFS_ROOT not enabled)\n");
+		return -1;
+#endif
+	}
+
+	/* Convert root name to dev_t */
+	if (!strncmp(root_name, "mtd", 3) ||
+	    !strncmp(root_name, "ubi", 3)) {
+		/* Handle MTD/UBI devices directly - these don't use the standard mount logic */
+		put_page(page);
+		mount_block_root((char *)root_name, root_mountflags);
+		return 0; /* If we get here, mounting succeeded */
+	}
+
+	ROOT_DEV = name_to_dev_t(root_name);
+	if (ROOT_DEV == 0) {
+		printk(KERN_WARNING "VFS: Cannot resolve root device: %s\n", root_name);
+		put_page(page);
+		return -1;
+	}
+
+	/* Create /dev/root device */
+	if (create_dev("/dev/root", ROOT_DEV) < 0) {
+		printk(KERN_WARNING "VFS: Failed to create /dev/root\n");
+		put_page(page);
+		return -1;
+	}
+
+	scnprintf(b, BDEVNAME_SIZE, "unknown-block(%u,%u)",
+		  MAJOR(ROOT_DEV), MINOR(ROOT_DEV));
+
+	if (root_fs_names)
+		num_fs = split_fs_names(fs_names, PAGE_SIZE, root_fs_names);
+	else
+		num_fs = list_bdev_fs_names(fs_names, PAGE_SIZE);
+
+	/* Try mounting with different filesystem types */
+	for (i = 0, p = fs_names; i < num_fs; i++, p += strlen(p)+1) {
+		int err;
+
+		if (!*p)
+			continue;
+		err = do_mount_root("/dev/root", p, root_mountflags, root_mount_data);
+		switch (err) {
+			case 0:
+				ret = 0;
+				goto out;
+			case -EACCES:
+			case -EINVAL:
+				continue;
+		}
+		printk(KERN_WARNING "VFS: Cannot open root device \"%s\" or %s: error %d\n",
+		       root_name, b, err);
+	}
+
+	/* Try read-only if read-write failed */
+	if (!(root_mountflags & SB_RDONLY)) {
+		for (i = 0, p = fs_names; i < num_fs; i++, p += strlen(p)+1) {
+			int err;
+
+			if (!*p)
+				continue;
+			err = do_mount_root("/dev/root", p, root_mountflags | SB_RDONLY, root_mount_data);
+			switch (err) {
+				case 0:
+					ret = 0;
+					goto out;
+				case -EACCES:
+				case -EINVAL:
+					continue;
+			}
+		}
+	}
+
+out:
+	put_page(page);
+	return ret;
+}
